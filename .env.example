# =============================================================================
#  HBPlus Auth — Environment Variables Template
#  Copy this file → .env and fill in every value before running.
#  NEVER commit .env — it is listed in .gitignore.
# =============================================================================

# ── Firebase Project Config ───────────────────────────────────────────────────
# Source: Firebase Console → Project Settings → Your Apps → Web App SDK snippet

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Google OAuth 2.0 Client IDs ───────────────────────────────────────────────
# Source: Google Cloud Console → APIs & Services → Credentials

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Allowed Email Domain ──────────────────────────────────────────────────────
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=hbplus.fit
