rules_version = '2';

// ─── Firestore Security Rules ────────────────────────────────────────────────
// These rules enforce domain-level access control at the DATABASE layer.
// They are the backend enforcement complement to frontend domain validation.
//
// Enforcement layers:
//  Layer 1: Frontend (AuthContext) – immediate UX gate, signs out bad actors
//  Layer 2: Firestore rules below – prevents any direct API calls to Firestore
//            by unauthenticated or unauthorized users
//
// This prevents a user from bypassing the frontend by calling the Firestore
// REST API directly with a valid Firebase token from a foreign-domain account.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    /** True if the caller has a valid Firebase session */
    function isSignedIn() {
      return request.auth != null;
    }

    /** True if the caller's email is in one of the app's allowed domains */
    function isAuthorizedDomain() {
      return isSignedIn()
        && request.auth.token.email != null
        && (request.auth.token.email.matches('.*@hbplus\\.fit$')
            || request.auth.token.email.matches('.*@gmail\\.com$'));
    }

    /** True if the caller's email is verified by Google */
    function isEmailVerified() {
      return isSignedIn()
        && request.auth.token.email_verified == true;
    }

    /** True if the caller is operating on their OWN document */
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /** Fields the user is NOT allowed to write */
    function noRestrictedFieldChanges() {
      return !('role' in request.resource.data.diff(resource.data).affectedKeys())
          && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
          && !('email' in request.resource.data.diff(resource.data).affectedKeys())
          && !('domain' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── users collection ──────────────────────────────────────────────────

    match /users/{uid} {

      // READ: only the document owner, with authorised domain + verified email
      allow read: if isOwner(uid)
                  && isAuthorizedDomain()
                  && isEmailVerified();

      // CREATE: only for self, with authorised domain & verified email.
      //         Role MUST be "user" (not "admin") on initial write.
      allow create: if isOwner(uid)
                    && isAuthorizedDomain()
                    && isEmailVerified()
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.email == request.auth.token.email
                    && (request.resource.data.domain == 'hbplus.fit'
                        || request.resource.data.domain == 'gmail.com');

      // UPDATE: only the owner, with authorised domain.
      //         Users CANNOT change role, uid, email, or domain.
      allow update: if isOwner(uid)
                    && isAuthorizedDomain()
                    && isEmailVerified()
                    && noRestrictedFieldChanges();

      // DELETE: not allowed from client
      allow delete: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
